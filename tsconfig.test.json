{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-build",
    "sourceMap": false,
    "declaration": false,
    "esModuleInterop": true
  },
  "include": ["src/contracts/**/*.ts", "src/core/**/*.ts", "src/state/**/*.ts", "src/drive/**/*.ts", "src/testing/**/*.ts", "test/**/*.ts"]
}
