{
  "name": "brain-google-drive-sync",
  "version": "0.1.1",
  "private": true,
  "description": "Private mobile-compatible Obsidian plugin for safe BRAIN Google Drive synchronization.",
  "main": "main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "build": "node scripts/build.mjs && node scripts/verify-build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": ["obsidian", "plugin", "google-drive", "sync"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3"
  }
}
