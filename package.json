{
  "name": "brain-google-drive-sync",
  "version": "0.1.19",
  "private": true,
  "description": "Private mobile-compatible Obsidian plugin for safe BRAIN Google Drive synchronization.",
  "main": "main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/**/*.test.js\"",
    "test:bvp-root": "tsc -p test-platform/tsconfig.json && node --test .test-build/bvp/test-platform/test/*.test.js",
    "test:bvp-architecture-guard": "tsc -p test-platform/tsconfig.json && node --test .test-build/bvp/test-platform/test/architecture-guard.test.js",
    "test:bvp-architecture-metrics": "tsc -p test-platform/tsconfig.json && node --test .test-build/bvp/test-platform/test/architecture-metrics.test.js",
    "test:bvp-repository-check": "tsc -p test-platform/tsconfig.json && node --test .test-build/bvp/test-platform/test/repository-check-integration.test.js",
    "build": "node scripts/build.mjs && node scripts/verify-build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:focused": "npm run test:focused:dec339-step5",
    "test:focused:ws03": "tsc -p tsconfig.test.json && node --test \".test-build/tests/unit/phase3-drive.test.js\" \".test-build/tests/unit/dec339-remote-reader.test.js\" \".test-build/tests/adversarial/dec339-provider-changes-adversarial.test.js\" \".test-build/tests/contracts/dec339-inventory-contracts.test.js\"",
    "test:focused:dec339-step3": "tsc -p tsconfig.test.json && node --test \".test-build/tests/integration/dec339-step3-shadow-continuity.test.js\" \".test-build/tests/integration/dec339-indexeddb-transaction-integration.test.js\" \".test-build/tests/integration/dec339-local-observation-integration.test.js\" \".test-build/tests/unit/dec339-remote-reader.test.js\"",
    "test:focused:dec339-step4": "tsc -p tsconfig.test.json && node --test \".test-build/tests/integration/dec339-step4-observation-comparison.test.js\" \".test-build/tests/unit/dec339-snapshot-assembly.test.js\" \".test-build/tests/unit/dec339-planning-projection.test.js\" \".test-build/tests/integration/dec339-local-observation-integration.test.js\" \".test-build/tests/integration/dec339-step3-shadow-continuity.test.js\"",
    "test:focused:dec339-step5": "tsc -p tsconfig.test.json && node --test \".test-build/tests/integration/dec339-step5-gated-planner-cutover.test.js\" \".test-build/tests/integration/dec339-step4-observation-comparison.test.js\" \".test-build/tests/unit/dec339-snapshot-assembly.test.js\" \".test-build/tests/integration/dec339-local-observation-integration.test.js\" \".test-build/tests/adversarial/plugin-data-integrity-regression.test.js\" \".test-build/tests/adversarial/s09-g1-runtime-authority-interleavings.test.js\""
  },
  "keywords": [
    "obsidian",
    "plugin",
    "google-drive",
    "sync"
  ],
  "license": "UNLICENSED",
  "overrides": {
    "moment": "2.31.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3"
  }
}
